# ── Source chain (Sepolia) ───────────────────────────────────────────────────
SOURCE_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
SOURCE_CHAIN_NAME=Sepolia

# ── Destination chain ────────────────────────────────────────────────────────
# Change DEST_RPC_URL to point at any chain — no code changes needed.
DEST_RPC_URL=http://127.0.0.1:8545
DEST_CHAIN_NAME=Local

# ── Token decimals ───────────────────────────────────────────────────────────
# Decimals of the USDC token on the source chain. Standard USDC = 6.
USDC_DECIMALS=6

# ── Contract addresses (filled in after deployment) ──────────────────────────
VAULT_ADDRESS=0x4FC33f575Fc333E3673781B7bFD5070c99F196F6
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
BRIDGED_USDC_ADDRESS=0x...

# ── Relayer wallet ───────────────────────────────────────────────────────────
# Must have MINTER_ROLE on BridgedUSDC and enough gas on the destination chain.
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY

# ── Tuning ───────────────────────────────────────────────────────────────────
# Blocks to wait before processing an event (avoids reorg issues).
CONFIRMATIONS=2
# Block to start scanning from — set this to the BridgeVault deploy block
# so the sync skips all history before the contract existed.
START_BLOCK=0
# How often the live polling loop checks for new events (milliseconds).
POLL_INTERVAL_MS=10000
# Blocks per eth_getLogs call during historical sync.
# 2000 works on most public RPCs. Raise to 10000 for Alchemy/Infura with a key.
# Lower to 500 if you hit "block range too large" errors.
SYNC_BATCH_SIZE=2000
