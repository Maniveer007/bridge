# ── Source chain (Sepolia) ───────────────────────────────────────────────────
NEXT_PUBLIC_SOURCE_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
NEXT_PUBLIC_SOURCE_CHAIN_ID=11155111
NEXT_PUBLIC_SOURCE_CHAIN_NAME=Sepolia
NEXT_PUBLIC_SOURCE_EXPLORER=https://sepolia.etherscan.io

# ── Destination chain ────────────────────────────────────────────────────────
# Change these three vars to point at any destination chain — no code changes.
NEXT_PUBLIC_DEST_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_DEST_CHAIN_ID=31337
NEXT_PUBLIC_DEST_CHAIN_NAME=Local Chain
NEXT_PUBLIC_DEST_EXPLORER=http://localhost

# ── Token decimals ───────────────────────────────────────────────────────────
# Must match the USDC token on the source chain. Standard USDC = 6.
NEXT_PUBLIC_USDC_DECIMALS=6

# ── Contract addresses (filled in after deployment) ──────────────────────────
NEXT_PUBLIC_VAULT_ADDRESS=0x...
NEXT_PUBLIC_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
NEXT_PUBLIC_BRIDGED_USDC_ADDRESS=0x...
