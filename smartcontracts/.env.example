# ── Source chain (Sepolia) ───────────────────────────────────────────────────
SOURCE_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# ── Destination chain ────────────────────────────────────────────────────────
# Point this at any chain — Anvil, Hardhat node, or a real network.
# forge reads the chainId from the RPC automatically; nothing is hardcoded.
DEST_RPC_URL=http://127.0.0.1:8545

# ── Wallets ──────────────────────────────────────────────────────────────────
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
RELAYER_ADDRESS=0xYOUR_RELAYER_WALLET_ADDRESS

# ── Sepolia USDC (official Circle testnet address) ───────────────────────────
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# ── Filled in after deployment ───────────────────────────────────────────────
VAULT_ADDRESS=
BRIDGED_USDC_ADDRESS=

# ── Etherscan / explorer verification ───────────────────────────────────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
